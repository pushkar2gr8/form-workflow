{
  "name": "form-workflow",
  "version": "1.0.0",
  "description": "Formik workflow engine for conditional, nested multi-step forms",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/pushkar2gr8/form-workflow.git"
  },
  "homepage": "https://github.com/pushkar2gr8/form-workflow#readme",
  "bugs": {
    "url": "https://github.com/pushkar2gr8/form-workflow/issues"
  },
  "keywords": [
    "react",
    "formik",
    "form",
    "workflow",
    "multi-step",
    "wizard",
    "conditional"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "formik": "^2.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "formik": "^2.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
