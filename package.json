{
  "name": "form-workflow",
  "version": "1.0.1",
  "description": "Formik workflow engine for conditional, nested multi-step forms",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/pushkar2gr8/form-workflow.git"
  },
  "homepage": "https://github.com/pushkar2gr8/form-workflow#readme",
  "bugs": {
    "url": "https://github.com/pushkar2gr8/form-workflow/issues"
  },
  "keywords": [
    "react",
    "formik",
    "form",
    "workflow",
    "multi-step",
    "wizard",
    "conditional"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "dev": "npm run build && vite --host 0.0.0.0",
    "build:demo": "npm run build && vite build"
  },
  "peerDependencies": {
    "formik": "^2.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "formik": "^2.4.6",
    "lucide-react": "^1.67.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
